<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 音频焦点 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 可视化 FFT 采集（Android 6.0+ 需要 RECORD_AUDIO）-->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 唤醒锁（防止播放时 CPU 休眠） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.panmusic.carplayer.PanMusicCarApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PanMusicCarPlayer"
        android:usesCleartextTraffic="true">

        <!-- Splash -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PanMusicCarPlayer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <!-- Main (播放列表管理) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Player -->
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false" />

        <!-- Song List -->
        <activity
            android:name=".ui.SongListActivity"
            android:exported="false" />

        <!-- File Browser -->
        <activity
            android:name=".ui.FileBrowserActivity"
            android:exported="false" />

        <!-- 前台音乐播放服务 -->
        <service
            android:name="com.panmusic.carplayer.service.AudioPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>
</manifest>
