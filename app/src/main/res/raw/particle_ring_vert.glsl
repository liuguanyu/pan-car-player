#version 300 es
uniform mat4 uVP;
uniform vec4 uRingA[64];
uniform vec4 uRingH0[64];
uniform vec4 uRingH1[64];
uniform vec4 uLive0;
uniform vec4 uLive1;
uniform float uTime;
uniform float uPulse;
uniform float uLevel;
uniform float uHeadX;
uniform float uHeadVis;
uniform float uPx;
uniform float uLife;
uniform float uEnergy;
uniform vec3 uRingColor;
uniform float uCurve;
uniform float uCurvePhase;
out float vAlpha;
out float vSoft;
float hash(float n){ return fract(sin(n) * 43758.5453123); }
void main(){
  int slot = gl_InstanceID;
  vec4 A = uRingA[slot];
  if (A.y < 0.0) { gl_Position = vec4(2.0, 2.0, 2.0, 1.0); gl_PointSize = 0.0; vAlpha = 0.0; vSoft = 0.0; return; }
  vec4 H0 = uRingH0[slot];
  vec4 H1 = uRingH1[slot];
  float age = A.y;
  float t = age / uLife;
  float id = float(gl_VertexID);
  float rnd = hash(id * 1.37 + A.w * 91.7);
  float rnd2 = hash(id * 3.11 + A.w * 17.3 + 5.0);
  float theta = (id + (rnd2 - 0.5) * 0.9) / 240.0 * 6.2831853;
  float grow = 1.0 - exp(-age * 0.34);
  float R = A.z * (0.30 + 2.4 * grow) * (1.0 + 0.45 * uPulse * exp(-age * 1.3));
  float dh = uHeadX - A.x;
  float near = exp(-dh * dh * 5.0);
  float after = dh < 0.0 ? exp(dh * 0.9) : 0.0;
  float flare = uHeadVis * clamp(near + after * 0.8, 0.0, 1.0) * smoothstep(0.6, 2.5, age);
  R *= 1.0 + 0.22 * flare;
  float sd = A.w * 6.2831853;
  float k = 0.35 + 0.65 * smoothstep(0.0, 1.2, age);
  float live = (1.0 + 0.9 * uPulse) * (0.4 + 0.6 * smoothstep(0.0, 2.0, age));
  vec4 a0 = (H0 * k + uLive0 * live) * (1.0 + 0.8 * flare);
  vec4 a1 = (H1 * k + uLive1 * live) * (1.0 + 0.8 * flare);
  float w = uTime * 0.55;
  float rot = sd + age * (0.10 + 0.12 * A.w);
  float th = theta + rot;
  float f = 1.0;
  f += a0.x * cos(2.0 * th + sd + w);
  f += a0.y * cos(3.0 * th + sd * 1.3 - w * 1.2);
  f += a0.z * cos(4.0 * th + sd * 1.7 + w * 1.5);
  f += a0.w * cos(5.0 * th + sd * 2.1 - w * 1.8);
  f += a1.x * cos(6.0 * th + sd * 2.5 + w * 2.1);
  f += a1.y * cos(7.0 * th + sd * 2.9 - w * 2.4);
  f += a1.z * cos(8.0 * th + sd * 3.3 + w * 2.7);
  f = max(f, 0.4);
  float grain = (rnd - 0.5) * (0.06 + 0.14 * uLevel + 0.12 * t);
  float rr = R * (f + grain);
  float px = A.x + (rnd2 - 0.5) * 0.04;
  float py = uCurve * sin(px * 0.72 + uCurvePhase) + 0.16 * sin(px * 1.43 - uCurvePhase * 1.7);
  float pz = uCurve * 0.44 * cos(px * 0.55 + uCurvePhase * 0.8);
  vec3 tangent = normalize(vec3(1.0, uCurve * 0.72 * cos(px * 0.72 + uCurvePhase) + 0.16 * 1.43 * cos(px * 1.43 - uCurvePhase * 1.7), -uCurve * 0.44 * 0.55 * sin(px * 0.55 + uCurvePhase * 0.8)));
  vec3 sideA = normalize(cross(tangent, vec3(0.0, 1.0, 0.0)));
  vec3 sideB = normalize(cross(tangent, sideA));
  vec3 P = vec3(px, py, pz) + sideA * (rr * sin(th)) + sideB * (rr * cos(th));
  gl_Position = uVP * vec4(P, 1.0);
  float fadeIn = smoothstep(0.0, 0.25, age);
  float fadeOut = 1.0 - smoothstep(0.55, 1.0, t);
  float base = 0.32 + 0.50 * H1.w;
  vAlpha = clamp((base * fadeIn * fadeOut + 0.65 * flare) * (0.5 + 0.5 * rnd) * uEnergy, 0.0, 1.0);
  float d = max(gl_Position.w, 0.2);
  float size = (1.1 + 1.9 * rnd2) * uPx * (5.0 / d);
  size *= 1.0 + 0.9 * flare;
  gl_PointSize = clamp(size, 1.0, 28.0 * uPx);
  vSoft = smoothstep(2.4, 6.0, gl_PointSize / uPx);
}
