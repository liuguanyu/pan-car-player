<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_normal"
        android:paddingVertical="10dp"
        android:background="@drawable/header_gradient">

        <!-- 第一行：返回 / 标题 / 状态（Wi-Fi、车速） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/song_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="歌曲标题"
                android:textSize="20sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/spacing_normal" />

            <!-- 连接状态：Wi-Fi / 热点（未连接时半透明）。属于状态指示，不是播放控制 -->
            <ImageButton
                android:id="@+id/wifi_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_wifi"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Wi-Fi 热点重连"
                android:scaleType="fitCenter"
                android:padding="3dp"
                android:layout_marginEnd="12dp"
                app:tint="@android:color/white" />

            <!-- 实时车速（GPS）：七段数码管数字 + 单位，静止或无定位时自动隐藏 -->
            <com.baidu.carplayer.widget.LcdTextView
                android:id="@+id/speed_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/speed_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="km/h"
                android:textSize="12sp"
                android:textColor="@color/car_text_secondary"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 第二行：专辑 + 音频信息小字，与标题左边对齐（返回按钮 48dp + 间距 16dp） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="64dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/song_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专辑名称"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/car_text_secondary"
                android:layout_marginEnd="@dimen/spacing_normal" />

            <!-- 音频信息显示 -->
            <TextView
                android:id="@+id/audio_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载中..."
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textColor="@color/car_text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- 中间封面/占位区域 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        
        <!-- 粒子背景 -->
        <com.baidu.carplayer.widget.ParticleBackgroundView
            android:id="@+id/particle_background"
            android:layout_margin="32dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        
        <!-- 旋转唱片 -->
        <com.baidu.carplayer.widget.RotatingDiscView
            android:id="@+id/rotating_disc"
            android:layout_margin="32dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:elevation="8dp" />
        
        <!-- 旋转文字视图 -->
        <com.baidu.carplayer.widget.RotatingTextView
            android:id="@+id/rotating_text"
            android:layout_margin="32dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:elevation="12dp" />
        
        <!-- 粒子可视化（GLES 3.0）：铺满整个中间区域（不含歌词栏），与窗口背景无缝衔接 -->
        <com.baidu.carplayer.widget.ParticleGlView
            android:id="@+id/particle_gl_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.baidu.carplayer.widget.WaveGlView
            android:id="@+id/wave_gl_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.baidu.carplayer.widget.ThunderGlView
            android:id="@+id/thunder_gl_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.baidu.carplayer.widget.VisualizerView
            android:id="@+id/visualizer_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp"
            android:visibility="gone" />

        <!-- 音量控制悬浮条 -->
        <SeekBar
            android:id="@+id/volume_bar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:rotation="270"
            android:max="100"
            android:progress="50"
            android:visibility="gone"
            android:thumbTint="@color/car_accent"
            android:progressTint="@color/car_accent" />
        
    </FrameLayout>
    
    <!-- 歌词单行显示区域 - 紧贴在播放控制栏上方 -->
    <com.baidu.carplayer.widget.LrcView
        android:id="@+id/lrc_view"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="@dimen/spacing_small" />

    <!-- 底部控制区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium"
        android:id="@+id/control_bar"
        android:background="@drawable/bottom_control_gradient">

        <!-- 进度条和时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                style="@style/Text.Small"
                android:textColor="@android:color/white" />

            <SeekBar
                android:id="@+id/progress_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/spacing_small"
                android:progressDrawable="@drawable/progress_gradient"
                android:thumb="@drawable/progress_thumb"
                android:splitTrack="false"
                android:minHeight="6dp"
                android:maxHeight="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:thumbOffset="0dp" />

            <TextView
                android:id="@+id/total_time"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:gravity="end"
                style="@style/Text.Small"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- 播放控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="@dimen/spacing_small">

            <!-- 左侧控制区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/play_mode_button"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:src="@drawable/ic_repeat"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="播放模式"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="@dimen/spacing_large" />

                <ImageButton
                    android:id="@+id/previous_button"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_skip_previous"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="上一首"
                    app:tint="@android:color/white"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/spacing_medium" />

            </LinearLayout>

            <!-- 中间播放按钮 -->
            <ImageButton
                android:id="@+id/play_pause_button"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="播放/暂停"
                app:tint="@android:color/white"
                android:scaleType="fitCenter"
                android:padding="16dp" />

            <!-- 右侧控制区 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start">

                <ImageButton
                    android:id="@+id/next_button"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_skip_next"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="下一首"
                    app:tint="@android:color/white"
                    android:scaleType="fitCenter"
                    android:layout_marginStart="@dimen/spacing_medium" />

                <ImageButton
                    android:id="@+id/volume_button"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="音量"
                    app:tint="@android:color/white"
                    android:layout_marginStart="@dimen/spacing_large" />

                <ImageButton
                    android:id="@+id/visualizer_button"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:src="@drawable/ic_visualizer"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="切换音频可视化"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/playlist_button"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:src="@drawable/ic_playlist"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="播放列表"
                    app:tint="@android:color/white"
                    android:layout_marginStart="@dimen/spacing_small" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    
    </LinearLayout>

    <!-- 播放列表覆盖层 (默认隐藏) -->
    <include layout="@layout/layout_current_playlist"
        android:visibility="gone"/>

</FrameLayout>