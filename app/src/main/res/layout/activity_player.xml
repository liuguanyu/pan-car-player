<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/header_gradient">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tv_song_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/player_unknown_song"
                android:textColor="@color/textPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tv_song_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="200dp" />

            <TextView
                android:id="@+id/tv_format_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textHint"
                android:textSize="14sp"
                android:layout_marginStart="16dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="320dp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="32dp">

            <com.panmusic.carplayer.widget.VisualizerView
                android:id="@+id/visualizer_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.panmusic.carplayer.widget.ParticleBackgroundView
                android:id="@+id/particle_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.panmusic.carplayer.widget.RotatingDiscView
                android:id="@+id/rotating_disc_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:elevation="8dp" />

            <com.panmusic.carplayer.widget.RotatingTextView
                android:id="@+id/rotating_text_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:elevation="12dp" />

            <SeekBar
                android:id="@+id/volume_bar"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:rotation="270"
                android:max="100"
                android:progress="50"
                android:visibility="gone"
                android:thumbTint="@color/accent"
                android:progressTint="@color/accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:orientation="horizontal"
                android:background="@drawable/item_card_background"
                android:paddingVertical="4dp"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textHint"
                    android:textSize="10sp"
                    android:text="视效｜" />

                <TextView
                    android:id="@+id/tv_visualizer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

            </LinearLayout>

        </FrameLayout>

        <com.panmusic.carplayer.widget.LrcView
            android:id="@+id/lrc_view"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bottom_control_gradient">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:gravity="center" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:progressDrawable="@drawable/progress_gradient"
                    android:thumb="@drawable/progress_thumb"
                    android:splitTrack="false"
                    android:minHeight="6dp"
                    android:maxHeight="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:thumbOffset="0dp" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp"
                    android:gravity="center" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <ImageButton
                        android:id="@+id/btn_play_mode"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_repeat"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="播放模式"
                        app:tint="@android:color/white"
                        android:layout_marginEnd="20dp" />

                    <ImageButton
                        android:id="@+id/btn_previous"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_skip_previous"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="上一首"
                        app:tint="@android:color/white"
                        android:scaleType="fitCenter" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_play"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="播放/暂停"
                    app:tint="@android:color/white"
                    android:scaleType="fitCenter"
                    android:padding="16dp"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="start">

                    <ImageButton
                        android:id="@+id/btn_next"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_skip_next"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="下一首"
                        app:tint="@android:color/white"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btn_visualizer"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_visualizer"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="可视化"
                        app:tint="@android:color/white"
                        android:layout_marginStart="20dp" />

                    <ImageButton
                        android:id="@+id/btn_volume"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_volume_up"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="音量"
                        app:tint="@android:color/white"
                        android:layout_marginStart="12dp" />

                    <ImageButton
                        android:id="@+id/btn_playlist"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_playlist"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="播放列表"
                        app:tint="@android:color/white"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 播放列表覆盖层 (默认隐藏) -->
    <include
        android:id="@+id/playlist_panel"
        layout="@layout/layout_current_playlist"
        android:visibility="gone" />

</FrameLayout>
